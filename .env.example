# Copy to .env. Empty values are intentionally not credentials.
GOOGLE_API_KEY=
SMARTSTRESS_GEMINI_CHAT_MODEL=gemini-2.5-flash
SMARTSTRESS_GEMINI_EMBED_MODEL=gemini-embedding-001
# Optional explicit gateway; blank uses the official Google endpoint.
SMARTSTRESS_GEMINI_BASE_URL=
SMARTSTRESS_STRESS_THRESHOLD=0.5
SMARTSTRESS_DB_PATH=artifacts/runtime/smartstress.db
SMARTSTRESS_HOST=127.0.0.1
SMARTSTRESS_PORT=8000
# Blank automatically serves apps/web/dist after npm run build.
FRONTEND_PATH=
# Optional TiDB RAG; leave DB_HOST blank to disable external retrieval.
DB_HOST=
DB_PORT=4000
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=test
